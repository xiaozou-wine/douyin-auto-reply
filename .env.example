# 抖音目标好友昵称，按私信列表显示的昵称匹配
TARGET_FRIEND_NAME=好友昵称

# 每天要发送的图片路径，建议放在 images/ 下
IMAGE_PATH=images/spark.jpg

# 时区
TIMEZONE=Asia/Shanghai

# 被动监听轮询间隔，单位秒
CHECK_INTERVAL_SECONDS=30

# 每天兜底主动发送的随机时间范围
FALLBACK_AFTER=22:00
FALLBACK_BEFORE=23:30

# 首次登录等待时间，单位秒
LOGIN_WAIT_TIMEOUT_SECONDS=300

# 浏览器模式：服务器默认 headless
HEADLESS=true

# 操作失败后的重试间隔，单位秒
RETRY_INTERVAL_SECONDS=60

# 当天已发送后是否继续保持页面活跃
KEEP_ALIVE_AFTER_SENT=true
