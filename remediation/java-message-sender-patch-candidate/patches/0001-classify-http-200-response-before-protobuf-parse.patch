+    static SendMessageResponse.DySendMsgResponse parseHttp200SendResponse(
+            HttpResponse<byte[]> response
+    ) {
+        SendResponseClassifier.Assessment assessment = SendResponseClassifier.classify(
+                response.headers(),
+                response.body()
+        );
+        if (!assessment.permitsProtobuf()) {
+            throw new DouyinMessageException(
+                    ErrorCode.MESSAGE_SEND_FAILED,
+                    assessment.metadata()
+            );
+        }
+
+        final SendMessageResponse.DySendMsgResponse parsed;
+        try {
+            parsed = SendMessageResponse.DySendMsgResponse.parseFrom(response.body());
+        } catch (com.google.protobuf.InvalidProtocolBufferException ignored) {
+            throw new DouyinMessageException(
+                    ErrorCode.MESSAGE_SEND_FAILED,
+                    assessment.metadata(
+                            "PROTOBUF_PARSE",
+                            SendResponseClassifier.Reason.MALFORMED_PROTOBUF
+                    )
+            );
+        }
+
+        if (!parsed.getStatusMessage().equals("OK")) {
+            throw new DouyinMessageException(
+                    ErrorCode.MESSAGE_SEND_FAILED,
+                    assessment.metadata(
+                            "POST_PARSE",
+                            SendResponseClassifier.Reason.REMOTE_APPLICATION_FAILURE
+                    )
+            );
+        }
+        return parsed;
+    }
+
+    static void validateParsedSendResponse(
+            SendMessageResponse.DySendMsgResponse parsed,
+            SendResponseClassifier.Assessment assessment
+    ) {
+        String extraInfo = parsed.getMessageData().getMessageInfo().getExtraInfo();
+        if (extraInfo == null || extraInfo.isEmpty()) {
+            return;
+        }
+        try {
+            JSONObject extraMap = JSON.parseObject(extraInfo);
+            int statusCode = extraMap.getIntValue("status_code", 0);
+            if (statusCode != 0 && statusCode != 8101 && statusCode != 7174) {
+                throw new DouyinMessageException(
+                        ErrorCode.MESSAGE_SEND_FAILED,
+                        assessment.metadata(
+                                "POST_PARSE",
+                                SendResponseClassifier.Reason.REMOTE_APPLICATION_FAILURE
+                        )
+                );
+            }
+        } catch (DouyinMessageException error) {
+            throw error;
+        } catch (RuntimeException ignored) {
+            throw new DouyinMessageException(
+                    ErrorCode.MESSAGE_SEND_FAILED,
+                    assessment.metadata(
+                            "POST_PARSE",
+                            SendResponseClassifier.Reason.REMOTE_APPLICATION_FAILURE
+                    )
+            );
+        }
+    }
+
