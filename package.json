{
  "name": "douyin-spark-auto-reply",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "抖音单好友续火花自动发图服务",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright:install": "playwright install chromium",
    "credentials:refresh": "tsx src/credentials/refresh.ts",
    "credentials:validate": "tsx src/credentials/validate.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
